generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  /// ADMIN: gestiona usuarios, prompt e importación. EDITOR: crea, edita y publica análisis.
  role         String   @default("EDITOR")
  createdAt    DateTime @default(now())

  reports        Report[]        @relation("ReportCreatedBy")
  reviewing      Report[]        @relation("ReportReviewer")
  comments       ReportComment[]
  aiUsage        AiUsage[]
  summaries      MonthlySummary[]

  @@map("users")
}

/// Un análisis de un flujo/campaña de Optimove para un mes y una moneda.
model Report {
  id       String @id @default(uuid())
  flowName String
  month    Int // 1-12
  year     Int
  /// Mercado (VES/USD, CLP, PEN, MXN). Todos los montos están en USD.
  currency String

  /// DRAFT y IN_REVIEW: solo visibles para el equipo. PUBLISHED: visible en el enlace público.
  status String @default("DRAFT")
  /// V2 = creado en este sistema. V1 = importado del sistema anterior.
  source String @default("V2")
  legacyId String? @unique

  // Métricas. null = dato no disponible (nunca se inventa).
  targetedCustomers Int?
  emailsSent        Int?
  emailsOpened      Int?
  emailsClicked     Int?
  /// Depositantes según Optimove (captura).
  depositors        Int?
  /// IDs distintos contados en el CSV de depositantes (puede diferir de Optimove).
  uniqueDepositors  Int?
  avgDeposits       Float?
  avgDepositAmount  Float?
  avgActivityDays   Float?
  avgBetAmount      Float?
  avgNetRevenue     Float?
  avgSportBets      Float?

  analysis String @default("") @db.Text
  notes    String? @db.Text

  /// Metadatos de la última ejecución de IA (modelo, versión de prompt, avisos).
  aiModel       String?
  promptVersion Int?
  aiWarnings    Json?
  /// IDs con protagonismo en los KPI, calculados de los CSV (ver server/services/idInsights.js).
  idInsights    Json?
  analyzedAt    DateTime?

  createdById String?
  createdBy   User?        @relation("ReportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Quién debe revisar el reporte cuando está EN REVISIÓN (opcional).
  reviewerId  String?
  reviewer    User?        @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  submittedAt DateTime?
  files       ReportFile[]
  comments    ReportComment[]
  aiUsage     AiUsage[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  publishedAt DateTime?

  @@index([year, month])
  @@index([currency])
  @@index([status])
  @@index([reviewerId])
  @@map("reports")
}

/// Archivo original subido (captura o CSV), guardado en la base de datos.
model ReportFile {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  slot      String // clave del ítem requerido (ver server/lib/catalog.js)
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@unique([reportId, slot])
  @@map("report_files")
}

/// Versiones del prompt de análisis. Solo una activa por clave.
model PromptVersion {
  id        String   @id @default(uuid())
  key       String // "flow_analysis"
  version   Int
  content   String   @db.Text
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([key, version])
  @@map("prompt_versions")
}

/// Configuración interna (p. ej. secreto de sesión autogenerado).
model Setting {
  key   String @id
  value String @db.Text

  @@map("settings")
}

/// Registro de cada consulta a Gemini (para controlar consumo y costo).
model AiUsage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  kind      String // ANALYSIS | TEST
  model     String
  success   Boolean
  error     String?
  attempts  Int      @default(1)
  durationMs Int

  inputTokens    Int @default(0)
  outputTokens   Int @default(0) // incluye tokens de "pensamiento"
  totalTokens    Int @default(0)
  /// Costo estimado en USD con los precios vigentes al momento de la consulta.
  costUsd        Float @default(0)

  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  reportId String?
  report   Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  /// Copia del nombre/periodo del reporte por si luego se elimina.
  reportLabel String?
  userLabel   String?

  @@index([createdAt])
  @@map("ai_usage")
}

/// Comentarios internos del equipo y eventos (cambios de estado) de un reporte.
model ReportComment {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userLabel String? // copia del nombre por si se elimina el usuario
  /// COMMENT = escrito por alguien. EVENT = generado por el sistema (envío a revisión, publicación…).
  kind      String   @default("COMMENT")
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([reportId, createdAt])
  @@map("report_comments")
}

/// Resumen ejecutivo de todos los flujos publicados de un mes y una moneda (generado por IA).
model MonthlySummary {
  id       String @id @default(uuid())
  year     Int
  month    Int
  currency String

  /// DRAFT: solo el equipo. PUBLISHED: visible en el enlace público.
  status  String @default("DRAFT")
  content String @default("") @db.Text
  /// Cifras calculadas por el sistema con las que se generó el texto (no las inventa la IA).
  stats   Json?
  /// Cantidad de reportes incluidos al generar (para avisar si luego se publican más).
  reportCount Int @default(0)

  aiModel     String?
  generatedAt DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@unique([year, month, currency])
  @@map("monthly_summaries")
}
